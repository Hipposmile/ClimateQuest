msgstr "Error entering the action:"

#: aktionen/templates/track.html:176
msgid "Fehler beim Eintragen der Aktion."
msgstr "Error entering the action."

#: aktionen/templates/track.html:213
msgid "Wöchentliche Aktionen"
msgstr "Weekly Actions"

#: aktionen/templates/track.html:214
