"\n"
"        %(percent_done)s %% bis zum nächsten Credit geschafft. Dir fehlen "
"also noch %(klimapunkte_missing)s\n"
"        Klimapunkte."
msgstr ""
"\n"
"%(percent_done)s %% completed toward the next credit. So you still need "
"%(klimapunkte_missing)s climate points."

#: personals/templates/credit_view.html:36
msgid "1 Baum pflanzen"
msgstr "Plant 1 tree"

#: personals/templates/credit_view.html:37
msgid "Das kostet einen Credit"
msgstr "This costs one credit"

#: personals/templates/credit_view.html:40
#, python-format
msgid ""
"Du hast\n"
"            bereits %(tree_count)s Bäume gepflanzt:"
msgstr ""
"You have\n"
"            already planted %(tree_count)s trees:"

#: personals/templates/credit_view.html:44
#, python-format
msgid ""
"1 gepflanzter Baum (Sponsor:\n"
"                    %(sponsor)s) durch Plant-for-the-Planet:\n"
"                    <a href=\"%(url)s\" target=\"_blank\">Zertifikat</a>"
msgstr ""
"1 planted tree (sponsor: %(sponsor)s) by Plant-for-the-Planet: <a "
"href=\"%(url)s\" target=\"_blank\">Certificate</a>"

