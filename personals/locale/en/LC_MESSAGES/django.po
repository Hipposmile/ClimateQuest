#: personals/templates/credit_view.html:4
msgid "Sieh dir all deine Credits bei ClimateQuest an!"
msgstr "Look at all your credits on ClimateQuest!"

#: personals/templates/credit_view.html:7
#: personals/templates/credit_view.html:10
msgid "Credits"
msgstr "Credits"

#: personals/templates/credit_view.html:17
#, python-format
msgid ""
"Du brauchst %(klimapunkte)s\n"
"        Klimapunkte, um einen Credit zu verdienen"
msgstr "You need %(klimapunkte)s climate points to earn a credit"

#: personals/templates/credit_view.html:20
msgid "Zur Verfügung stehende Credits:"
msgstr "Available credits:"

#: personals/templates/credit_view.html:31
#, python-format
